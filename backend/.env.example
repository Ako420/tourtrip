PORT=5000
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/hotel_jr?schema=public"

# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d

# From the Cloudinary dashboard. The server won't start until these are filled in.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# From the Claude Console. Optional: without it, only the travel assistant is switched off.
ANTHROPIC_API_KEY=

# For tests, copy this to .env.test, add NODE_ENV=test and use a database ending in _test.
# Use fake Cloudinary values there, so tests can't reach the real account.
