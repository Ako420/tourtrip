generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id              String          @id @default(cuid())
  fullName        String
  email           String          @unique
  passwordHash    String
  phone           String?
  avatarUrl       String?
  role            Role            @default(USER)
  emailVerifiedAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  assets          Asset[]
  reviews         Review[]
  supportTickets  SupportTicket[]
}

model Asset {
  id           String   @id @default(cuid())
  publicId     String   @unique
  url          String
  folder       String
  width        Int
  height       Int
  format       String
  bytes        Int
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([folder])
}

model Hotel {
  id                String     @id @default(cuid())
  slug              String     @unique
  name              String
  area              String
  city              String
  country           String
  address           String
  description       String
  imageUrl          String
  images            String[]
  highlights        String[]
  stars             Int
  rating            Float      @default(0)
  reviewCount       Int        @default(0)
  pricePerNight     Decimal    @db.Decimal(10, 2)
  originalPrice     Decimal?   @db.Decimal(10, 2)
  currency          String     @default("USD")
  freeCancellation  Boolean    @default(false)
  breakfastIncluded Boolean    @default(false)
  sortRank          Int        @default(0)
  reviewScores      Json
  policies          Json
  nearby            Json
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  amenities         Amenity[]
  rooms             RoomType[]
  reviews           Review[]

  @@index([city])
  @@index([pricePerNight])
  @@index([rating])
}

model Amenity {
  id        String   @id
  label     String
  iconName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hotels    Hotel[]
}

model RoomType {
  id                String   @id @default(cuid())
  hotelId           String
  hotel             Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name              String
  beds              String
  maxGuests         Int
  pricePerNight     Decimal  @db.Decimal(10, 2)
  isAvailable       Boolean  @default(true)
  imageUrl          String
  sizeSqm           Int
  freeCancellation  Boolean  @default(false)
  breakfastIncluded Boolean  @default(false)
  totalRooms        Int      @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([hotelId])
}

model Review {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookingId String?  @unique
  author    String
  country   String
  score     Float
  stayDate  String
  title     String
  text      String
  photos    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hotelId, createdAt])
}

model ContentBlock {
  key       String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id        String   @id
  product   String
  question  String
  answer    String
  sortRank  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TicketStatus {
  OPEN
  CLOSED
}

model SupportTicket {
  id               String       @id @default(cuid())
  reference        String       @unique
  userId           String?
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName         String
  email            String
  topic            String
  bookingReference String?
  message          String
  status           TicketStatus @default(OPEN)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([userId])
}

model Airport {
  id                String           @id @default(cuid())
  code              String           @unique
  city              String           @unique
  country           String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  outgoingSchedules FlightSchedule[] @relation("ScheduleFrom")
  incomingSchedules FlightSchedule[] @relation("ScheduleTo")
}

model Airline {
  id        String           @id @default(cuid())
  code      String           @unique
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  schedules FlightSchedule[]
  deals     FlightDeal[]
}

model FlightSchedule {
  id                String            @id @default(cuid())
  airlineId         String
  airline           Airline           @relation(fields: [airlineId], references: [id])
  flightNumber      String
  aircraft          String
  fromAirportId     String
  fromAirport       Airport           @relation("ScheduleFrom", fields: [fromAirportId], references: [id])
  toAirportId       String
  toAirport         Airport           @relation("ScheduleTo", fields: [toAirportId], references: [id])
  departMinutes     Int
  durationMinutes   Int
  stops             Int               @default(0)
  stopCity          String?
  baseFare          Decimal           @db.Decimal(10, 2)
  checkedBag        Boolean           @default(false)
  refundable        Boolean           @default(false)
  seatsPerCabin     Int
  returnScheduleId  String?
  returnSchedule    FlightSchedule?   @relation("ReturnSchedule", fields: [returnScheduleId], references: [id], onDelete: SetNull)
  outboundSchedules FlightSchedule[]  @relation("ReturnSchedule")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  departures        FlightDeparture[]

  @@index([fromAirportId, toAirportId])
}

model FlightDeparture {
  id          String         @id @default(cuid())
  scheduleId  String
  schedule    FlightSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  date        DateTime       @db.Date
  cabin       String
  seatsBooked Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([scheduleId, date, cabin])
}

model FlightDeal {
  id         String   @id @default(cuid())
  airlineId  String
  airline    Airline  @relation(fields: [airlineId], references: [id])
  fromCity   String
  toCity     String
  departDate DateTime @db.Date
  returnDate DateTime @db.Date
  cabin      String
  isNonstop  Boolean  @default(false)
  price      Decimal  @db.Decimal(10, 2)
  currency   String   @default("USD")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
